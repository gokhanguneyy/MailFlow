@model CompanyDraftWorkspaceViewModel

@{
    ViewData["Title"] = "Taslak Oluştur";
    ViewData["UseFluidContainer"] = true;
}

<section class="draft-page">
    <div class="company-shell">
        <div class="company-header">
            <p class="company-kicker">Taslak</p>
            <h1>Taslak Oluştur</h1>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
        {
            <div class="alert alert-success mail-template-alert" role="alert">
                @Model.SuccessMessage
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger mail-template-alert" role="alert">
                @Model.ErrorMessage
            </div>
        }

        <div class="draft-control-panel">
            <div class="draft-gmail-status">
                @if (!Model.IsGmailConfigured)
                {
                    <span class="draft-status-badge draft-status-warning">Gmail ayarı eksik</span>
                }
                else if (Model.IsGmailConnected)
                {
                    <span class="draft-status-badge draft-status-ready">Gmail bağlı</span>
                }
                else
                {
                    <a asp-action="GmailBaglan"
                       asp-route-mailTemplateId="@Model.SelectedMailTemplateId"
                       class="btn btn-primary draft-connect-button">
                        Gmail'e Bağlan
                    </a>
                }
            </div>
        </div>

        <section class="draft-split-list" aria-label="Taslak oluşturma listesi">
            <div class="draft-list-column">
                <div class="draft-list-heading">
                    <div>
                        <p class="company-kicker">Sol Liste</p>
                        <h2>Kayıtlı Şirketler</h2>
                    </div>
                    <span class="record-count">@Model.AvailableCompanies.Count kayıt</span>
                </div>

                <form asp-action="TaslakOlustur" method="post" class="draft-list-form">
                    @Html.AntiForgeryToken()

                    <div class="draft-template-picker">
                        <label for="mailTemplateId">Mail Şablonu</label>
                        <select id="mailTemplateId"
                                name="mailTemplateId"
                                class="form-select"
                                disabled="@(!Model.HasMailTemplates)">
                            @if (Model.HasMailTemplates)
                            {
                                @foreach (var template in Model.MailTemplates)
                                {
                                    <option value="@template.Id" selected="@(template.Id == Model.SelectedMailTemplateId)">
                                        @template.Title
                                    </option>
                                }
                            }
                            else
                            {
                                <option value="">Kayıtlı mail şablonu yok</option>
                            }
                        </select>
                    </div>

                    @if (Model.HasAvailableCompanies)
                    {
                    <ul class="draft-company-list">
                        @foreach (var company in Model.AvailableCompanies)
                        {
                            <li class="draft-company-row">
                                <div class="draft-company-info">
                                    <strong>@company.CompanyName</strong>
                                    <span>@company.CompanyEmail</span>
                                    <a href="@company.LinkedInUrl" target="_blank" rel="noreferrer">@company.Domain</a>
                                </div>
                                <button type="submit"
                                        name="domain"
                                        value="@company.Domain"
                                        class="btn btn-primary draft-button"
                                        disabled="@(!Model.IsGmailConfigured || !Model.IsGmailConnected || !Model.HasMailTemplates)">
                                    Taslak Oluştur
                                </button>
                            </li>
                        }
                    </ul>
                    }
                    else
                    {
                        <div class="empty-company-list">Taslağa alınacak şirket yok.</div>
                    }
                </form>
            </div>

            <div class="draft-list-column draft-created-column">
                <div class="draft-list-heading">
                    <div>
                        <p class="company-kicker">Sağ Liste</p>
                        <h2>Taslak Oluşturulanlar</h2>
                    </div>
                    <span class="record-count">@Model.CreatedDrafts.Count kayıt</span>
                </div>

                @if (Model.HasCreatedDrafts)
                {
                    <ul class="draft-company-list">
                        @foreach (var draft in Model.CreatedDrafts)
                        {
                            <li class="draft-company-row draft-created-row">
                                <div class="draft-company-info">
                                    <strong>@draft.CompanyName</strong>
                                    <span>@draft.CompanyEmail</span>
                                    <span>@draft.MailSubject</span>
                                    <a href="@draft.LinkedInUrl" target="_blank" rel="noreferrer">@draft.Domain</a>
                                </div>
                                <div class="draft-created-meta">
                                    <time class="draft-created-time">@draft.DraftCreatedAt</time>
                                    <span>@draft.GmailDraftId</span>
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="empty-company-list">Henüz taslak oluşturulmadı.</div>
                }
            </div>
        </section>
    </div>
</section>
